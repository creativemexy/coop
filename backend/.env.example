# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=coop_bnpl
DB_SYNCHRONIZE=true
DB_LOGGING=false

# CORS (comma-separated origins allowed; use secrets manager in production)
CORS_ORIGINS=http://localhost:5173

# Encryption (32+ char passphrase for AES-256-GCM; use secrets manager in production)
ENCRYPTION_KEY=change-me-to-a-32-char-or-longer-passphrase

# JWT (use secrets manager in production, e.g. AWS Secrets Manager / HashiCorp Vault)
JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx

# Korapay
KORAPAY_SECRET_KEY=sk_test_xxx
KORAPAY_PUBLIC_KEY=pk_test_xxx

# Termii
TERMII_API_KEY=your-termii-api-key
TERMII_SENDER_ID=CoopBNPL

# SMTP (for email sending)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
SMTP_FROM=noreply@coop.com

# Data Retention (days)
RETENTION_LOGIN_HISTORY_DAYS=90
RETENTION_DEVICE_SESSIONS_DAYS=180
RETENTION_USER_ACTIVITIES_DAYS=90
RETENTION_SMS_LOGS_DAYS=90
RETENTION_WEBHOOK_LOGS_DAYS=30
RETENTION_BNPL_AUDIT_LOGS_DAYS=365
RETENTION_SUPPORT_TICKETS_DAYS=365
RETENTION_IN_APP_NOTIFICATIONS_DAYS=30
RETENTION_KYC_SUBMISSIONS_DAYS=1825
RETENTION_USER_ACCOUNT_DAYS=730
RETENTION_AUDIT_LOGS_DAYS=365

# App
APP_PORT=3000
APP_ENV=development

# Fee Distribution (decimal percentages)
FEE_BUSINESS_MANAGER_PERCENT=0.20
FEE_PLATFORM_PERCENT=0.30
FEE_ORGANIZATION_PERCENT=0.35
FEE_APEX_PERCENT=0.15
# FirstCheckout (virtual bank accounts for individual members + deposits)
FIRST_BANKOUT_ENABLED=false
FIRST_BANKOUT_API_URL=https://www.firstchekoutdev.com
FIRST_BANKOUT_PUBLIC_KEY=
FIRST_BANKOUT_SECRET_KEY=
FIRST_BANKOUT_MERCHANT_ID=
FIRST_BANKOUT_CLIENT_ID=
FIRST_BANKOUT_CLIENT_SECRET=
FIRST_BANKOUT_VA_INIT_AMOUNT=5000
FIRST_BANKOUT_AMOUNT_DIVISOR=1
